# Agent Games agent server — lotnokjumbo
# NEVER commit this file. Copy to .env and fill in real values.

# Port the HTTP server listens on (default 3000)
PORT=3000

# HMAC secret for the Proof Gatekeeper agent registration.
# Shown ONCE on the dashboard (Rotate Secret). Set it here after registering.
# The server 401s all POSTs until this is set.
AGENT_GAMES_HMAC_SECRET=

# HMAC secret for the Steal the VFY agent registration (a SECOND registration
# on the same endpoint). If empty, Steal requests are verified against the
# main secret above.
AGENT_GAMES_HMAC_SECRET_STEAL=

# Steal strategy salt: 32-byte hex (64 hex chars), generated once, never shared.
# The commitment registered on the dashboard is derived from this + the params.
STEAL_SALT=

# Steal strategy params (defaults match the registered policy; change only
# BEFORE registering the commitment — it is frozen once registered).
STEAL_EXTRACT_AMOUNT=10
STEAL_FORTIFY_BELOW=60
STEAL_EXTRACT_ABOVE=40
STEAL_EXTRACT_DISABLED=0

# Directory for the seen-set / response cache JSON store (default ./data)
DATA_DIR=
